PORT=5000
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=1d
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_your_secret_password
CLIENT_ORIGIN=*

# ── GitHub auto-sync (হোম পেজ কনটেন্ট PERMANENT রাখতে — Render-এ দিতে হবে) ──
# Render Dashboard → আপনার service → Environment → নিচের ৩টা variable বসান:
# GIT_REPO_OWNER  = GitHub account/repo owner (যেমন: pbon99449-hub)
# GIT_REPO_NAME   = Repository নাম (যেমন: softverseit)
# GIT_BRANCH      = যেই branch-এ Render deploy হয় (সাধারণত master)
# GIT_PUSH_TOKEN  = GitHub fine-grained Personal Access Token
#                   (GitHub → Settings → Developer settings → Personal access tokens
#                    → Fine-grained tokens → আপনার repo-র "Contents: Read and write"
#                    permission দিন — এই কাজেই শুধু এই token-টা বানান)
# এটা বসালে admin panel-এ save করার সাথে সাথেই কনটেন্ট GitHub-এ commit হয়
# এবং যতবার Render restart/redeploy হোক, সেভ করা কনটেন্ট ফিরে আসবে।
