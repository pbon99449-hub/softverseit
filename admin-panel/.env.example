PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/softverse_admin
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=1d

# Used once by "npm run seed" to create the first admin account
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@softverseit.com
ADMIN_PASSWORD=ChangeMe123!

# Comma separated list of origins allowed to call the public API
# (the main SoftVerse IT website). Use * for development.
CLIENT_ORIGIN=*
