PORT=5000
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=30d
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_your_secret_password
CLIENT_ORIGIN=*

# ── GitHub auto-sync (লোকাল admin থেকেও সেভ করলেই GitHub-এ push হবে) ──
# Render-এ যেভাবে বসানো, ঠিক তেমনই এই ৪টা ভেরিয়েবল এখানে বসালে লোকাল admin
# panel-এ সেভ করা কনটেন্ট/কোর্স/রেজাল্টও সাথে সাথে GitHub-এ commit হয় →
# Render auto-deploy হয়ে লাইভ সাইটে চলে যায়। Render ড্যাশবোর্ডের env-এ থাকা
# একই টোকেন এখানে বসালেই হবে।
